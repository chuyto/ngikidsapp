# Plantilla de variables para Wasmer Edge.
# Copia cada clave al dashboard: tu app > Settings > Secrets / Environment,
# o con CLI:  wasmer app secrets create APP_KEY "base64:..."
#
# BD GESTIONADA DE WASMER (MySQL): en el flujo de subida activa
# "Enable Database" (MySQL) o crea la BD en la pestana Databases del
# dashboard. Wasmer INYECTA SOLO estas 5 (NO las pongas manual):
#   DB_HOST, DB_PORT (NO es 3306, usa el de la tarjeta), DB_NAME,
#   DB_USERNAME, DB_PASSWORD.
# La UNICA que debes agregar manual es DB_DATABASE, con el MISMO valor
# del "Name" de la tarjeta (Laravel usa DB_DATABASE, no DB_NAME).
# Reglas del nombre: empieza con letra, letras/numeros/guion bajo,
# minimo 5 caracteres, unico en todo Wasmer (ej: ngikidsapp_db).

APP_NAME="NGIKids"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Mexico_City
APP_URL=https://ngikidsapp.wasmer.app

# Proxies de confianza. En Wasmer el trafico entra por su proxy: "*".
TRUSTED_PROXIES=*
# Version del Aviso de Privacidad que se guarda con cada consentimiento.
PRIVACIDAD_VERSION=2026-11

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# En Edge los logs deben ir a stderr para verlos en el dashboard.
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
# INYECTADAS por Wasmer: NO definir manual (ver nota arriba).
# DB_HOST=
# DB_PORT=
# DB_NAME=
# DB_USERNAME=
# DB_PASSWORD=
# MANUAL: mismo valor que el "Name" de la tarjeta de la BD.
DB_DATABASE=

# TLS: Wasmer usa CA privada -> verificar apagado (el proyecto ya lo soporta).
MYSQL_ATTR_SSL_CA=
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

# Sesiones/cache en BD para sobrevivir al filesystem efimero de Edge.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wasmer sirve por HTTPS: la cookie de sesión solo viaja por TLS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Sin worker en Edge: sync ejecuta los jobs en la misma peticion.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

# log = NO entrega correos. Cambia a smtp y carga credenciales si
# necesitas restablecimiento de contraseña o avisos por correo.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CLOUDINARY_URL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

WALLETWALLET_API_KEY=

ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
