APP_NAME=NGIKids
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Mexico_City
APP_URL=http://localhost

# Proxies de confianza (IPs/CIDR separados por coma). "*" confía en todos:
# útil en Render, donde solo el proxy alcanza la app. Si el servidor está
# expuesto directamente, restringe la lista.
TRUSTED_PROXIES=*
# Versión del Aviso de Privacidad que se guarda con cada consentimiento.
PRIVACIDAD_VERSION=2026-11

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ngikidsapp
DB_USERNAME=root
DB_PASSWORD=

# Conexión MySQL con TLS (Aiven u otro proveedor remoto).
# Si MYSQL_ATTR_SSL_CA se deja vacía (SSLE) se conecta con TLS sin verificar el certificado.
# En Render define MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false y omite MYSQL_ATTR_SSL_CA.
MYSQL_ATTR_SSL_CA=
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

CLOUDINARY_URL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Apple/Google Wallet: https://www.walletwallet.dev (Soporta Apple Wallet y Google Wallet)
WALLETWALLET_API_KEY=

# Cuenta administradora creada por el seeder (AdminUserSeeder)
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
